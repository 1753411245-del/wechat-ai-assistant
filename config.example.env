# ============ 微信 AI 助手配置（复制成 config.env 后修改）============
# 运行 python src/setup.py 可以自动生成这个文件

# 要接管的会话：私聊填 wxid，群填 xxx@chatroom，逗号分隔
# 留空 + AUTO_PRIVATE=1 = 自动接管所有私聊
WXAI_WATCH=

# 自动接管所有私聊（含新加好友）
WXAI_AUTO_PRIVATE=1

# 群里只有 @ 才回复
WXAI_AT_ONLY=1
# @ 时的昵称，多个逗号分隔；留空=自动识别（账号昵称 + 群备注）
WXAI_AT_NAME=

# 收到语音/图片时的自动回复（留空=忽略）
WXAI_HINT=我这边听不了语音，打字说下呗

# 同一会话两次回复最小间隔（秒）
WXAI_MIN_GAP=8
# 全局每分钟最多回复条数（防失控）
WXAI_MAX_REPLIES_PER_MIN=10

# 不接管的会话前缀/后缀（公众号、系统号等）
WXAI_SKIP_PREFIX=gh_,newsapp,brandsessionholder,filehelper,fmessage,medianote,floatbottle,qqmail,@openim,gamelife

# 需要人工接手时，推一条提醒到这个会话
WXAI_ESCALATE=1
WXAI_ESCALATE_TO=filehelper

# 定时汇总：每天几点发到 filehelper（留空=关闭）
WXAI_DIGEST_TO=filehelper
WXAI_DIGEST_AT=21:00
# 或者按小时间隔推送：WXAI_DIGEST_EVERY=3600（设置了 AT 就以 AT 为准）
WXAI_DIGEST_EVERY=0

# 模型（OpenAI 兼容协议）
WXAI_BASE_URL=https://api.deepseek.com/v1
WXAI_MODEL=deepseek-chat
OPENAI_API_KEY=

# 人设
WXAI_PERSONA=你是我的私人助理，回复简短口语化，80字内，不用markdown；问价格/库存/承诺时不要自己编，说"我帮您问下本人，稍等"

# 多账号（数据目录或账号不是默认时填）
# WXAI_DB_DIR=
# WXAI_ACCOUNT=
